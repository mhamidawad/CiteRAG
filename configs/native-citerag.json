{
  "agents": {
    "citerag-answer": {
      "description": "Use the authenticated, project-scoped CiteRAG search tool, no other tools.",
      "mode": "primary",
      "model": {
        "model": "ollama-local/qwen3.5:4b-opencode",
        "providerID": "omniroute"
      },
      "permissions": [
        {
          "action": "*",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "citerag_rag_search",
          "effect": "allow",
          "resource": "*"
        }
      ],
      "steps": 3,
      "system": "Call citerag_rag_search with query equal to the user question and numeric limit 1. Then copy the returned verbatim_answer string EXACTLY, including its source path and chunk identifier. Do not paraphrase, introduce, invent facts, or use any other tool. If the tool returns no evidence, respond exactly: Insufficient evidence in the approved project sources."
    }
  },
  "mcp": {
    "servers": {
      "citerag": {
        "codemode": false,
        "headers": {
          "Authorization": "Bearer {env:CITERAG_API_TOKEN}"
        },
        "type": "remote",
        "url": "{env:CITERAG_NATIVE_MCP_URL}"
      }
    }
  },
  "model": {
    "model": "ollama-local/qwen3.5:4b-opencode",
    "providerID": "omniroute"
  },
  "permissions": [
    {
      "action": "*",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "citerag_rag_search",
      "effect": "allow",
      "resource": "*"
    }
  ],
  "plugins": [
    "-opencode.tool.*",
    "-opencode.browser",
    "-opencode.tools"
  ],
  "providers": {
    "omniroute": {
      "models": {
        "ollama-local/qwen3.5:4b-opencode": {
          "body": {
            "max_tokens": 512,
            "reasoning_effort": "none",
            "temperature": 0
          },
          "name": "Local Qwen RAG"
        }
      },
      "name": "OmniRoute",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "apiKey": "{env:CITERAG_OMNIROUTE_API_KEY}",
        "baseURL": "http://127.0.0.1:20128/v1"
      }
    }
  }
}
